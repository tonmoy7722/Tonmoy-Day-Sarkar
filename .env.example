# Copy this file to .env for LOCAL testing only.
# On Render, set these under your Web Service's "Environment" tab instead —
# never commit a real .env file to GitHub.

# ---- Required: contact form email (sent via Resend — see README) ----
# Free API key from https://resend.com — no card, no domain needed, since
# messages are only ever sent TO your own address below.
RESEND_API_KEY=re_yourapikeyhere
# The email address you signed up to Resend with — contact messages go here.
TO_EMAIL=youraddress@example.com

# ---- Required: which frontend URLs may call this API ----
# Comma-separated. Use * only while testing; lock it down before going live.
ALLOWED_ORIGINS=*

# ---- Optional: enables message history, visit/CV-download tracking, admin view ----
# Free Postgres from https://neon.tech or https://supabase.com — paste the
# connection string they give you (usually starts with postgres://...).
DATABASE_URL=

# ---- Optional: protects the /admin page and /api/admin/* routes ----
# Pick any password of your own choosing.
ADMIN_PASSWORD=

# ---- Optional: powers the "Ask about Tonmoy" chat widget ----
# Free API key from https://console.groq.com
GROQ_API_KEY=

# ---- Optional: overrides for the publications/projects feeds ----
# Defaults already match Tonmoy's accounts — only set these if that changes.
ORCID_ID=0009-0007-3565-6578
GITHUB_USERNAME=tonmoy7722
