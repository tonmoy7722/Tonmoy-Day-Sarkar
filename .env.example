# Copy this file to .env for LOCAL testing only.
# On Render, set these under your Web Service's "Environment" tab instead —
# never commit a real .env file to GitHub.

# ---- Required: contact form email (sent via Resend — see README) ----
# Free API key from https://resend.com — no card, no domain needed, since
# messages are only ever sent TO your own address below.
RESEND_API_KEY=re_yourapikeyhere
# The email address you signed up to Resend with — contact messages go here.
TO_EMAIL=youraddress@example.com

# ---- Required: which frontend URLs may call this API ----
# Comma-separated. Use * only while testing; lock it down before going live.
ALLOWED_ORIGINS=*

# ---- Optional: enables message history, visit/CV-download tracking, admin view ----
# Free Postgres from https://neon.tech (recommended — works over plain IPv4,
# no extra setup) or https://supabase.com (use the "Session pooler" connection
# string, not "Direct connection" — the direct one is IPv6-only and will fail
# on Render with an ENETUNREACH error).
DATABASE_URL=

# ---- Optional: protects the /admin page and /api/admin/* routes ----
# Pick any password of your own choosing.
ADMIN_PASSWORD=

# ---- Optional: powers the "Ask about Tonmoy" chat widget ----
# Free API key from https://console.groq.com
GROQ_API_KEY=

# ---- Optional: overrides for the publications/projects feeds ----
# Defaults already match Tonmoy's accounts — only set these if that changes.
# Note: publications only appear if every work on the ORCID account is set to
# "Everyone" visibility (orcid.org → log in → Works → visibility icon on each
# item) — items marked Trusted-parties or Only-me are invisible to the public
# API this backend uses, even though the researcher can see them fine.
ORCID_ID=0009-0007-3565-6578
GITHUB_USERNAME=tonmoy7722

# ---- Optional but recommended: avoids GitHub API rate-limit errors ----
# Without this, GitHub allows only 60 requests/hour shared across everyone on
# Render's free-tier IPs — often already used up, causing "GitHub API
# returned 403". A token raises this to 5,000/hour just for you.
# Create one (classic token, no scopes needed — public read-only) at:
# https://github.com/settings/tokens → Generate new token (classic) →
# no scopes checked → Generate → copy the token (starts with ghp_).
GITHUB_TOKEN=
